<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Erdyka Gestión</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Estilos personalizados con tonos Pastel / Lila -->
    <style>
            :root {
                --pastel-lila: #f3e8ff;
                --pastel-lila-oscuro: #d8b4fe;
                --purple-main: #7e22ce;
                --purple-hover: #6b21a8;
            }

            body {
                background-color: #fdfcff;
                color: #2d3748;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .navbar-custom {
                background: linear-gradient(135deg, #7e22ce, #a855f7) !important;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

            .btn-pastel-primary {
                background-color: #a855f7;
                color: white;
                border: none;
                transition: all 0.3s ease;
            }

                .btn-pastel-primary:hover {
                    background-color: #9333ea;
                    color: white;
                    transform: translateY(-2px);
                    box-shadow: 0 4px 12px rgba(168, 85, 247, 0.3);
                }

            .card-dashboard {
                border: none;
                border-radius: 12px;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                background: white;
            }

                .card-dashboard:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 10px 20px rgba(126, 34, 206, 0.1);
                }

            .bg-pastel-lila {
                background-color: var(--pastel-lila) !important;
                color: #581c87 !important;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-custom py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4" asp-page="/Index">✨ Erdyka System</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-page="/Index">🏠 Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-page="/Pedidos">📋 Gestión de Pedidos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-page="/Productos">📦 Catálogo y Stock</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="btn btn-light btn-sm text-purple fw-semibold px-3 py-2 shadow-sm" asp-page="/Auth/Login">🔐 Iniciar Sesión / Registro</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3 bg-white mt-auto">
        <div class="container">
            &copy; 2026 - Erdyka Web System - Universidad Castro Carazo
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@page "{id:int}"
@model Erdyka.Web.Pages.EditarProductoModel
@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container mt-4" style="max-width: 600px;">
    <h3>Editar Producto</h3>

    <form method="post" class="mt-3">
        <input type="hidden" asp-for="Producto.Id" />

        <div class="mb-3">
            <label class="form-label">Nombre:</label>
            <input asp-for="Producto.Nombre" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción:</label>
            <input asp-for="Producto.Descripcion" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Precio:</label>
            <input asp-for="Producto.Precio" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Stock Actual:</label>
            <input asp-for="Producto.StockActual" type="number" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
        <a asp-page="/Productos" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
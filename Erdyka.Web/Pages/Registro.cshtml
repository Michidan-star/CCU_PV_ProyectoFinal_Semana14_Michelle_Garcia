@page
@model Erdyka.Web.Pages.RegistroModel
@{
    ViewData["Title"] = "Registro";
}

<div class="container mt-4">
    <h3>Registro de Nuevo Usuario</h3>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Nombre de Usuario:</label>
            <input asp-for="Usuario.NombreUsuario" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Correo:</label>
            <input asp-for="Usuario.Correo" type="email" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Contraseña:</label>
            <input asp-for="Usuario.Password" type="password" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Registrar</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-info mt-3" role="alert">
            @Model.Mensaje
        </div>
    }
</div>
@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio - Erdyka";
}

<div class="text-center">
    <h1 class="display-4">Bienvenida a Erdyka</h1>
    <p>Sistema de Gestión conectado a la API.</p>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger" role="alert">
        @Model.MensajeError
    </div>
}

<div class="row mt-4">
    <div class="col-md-12">
        <h3>Lista de Productos desde la API</h3>
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Stock</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Productos.Any())
                {
                    @foreach (var prod in Model.Productos)
                    {
                        <tr>
                            <td>@prod.Id</td>
                            <td>@prod.Nombre</td>
                            <td>@prod.Descripcion</td>
                            <td>$@prod.Precio</td>
                            <td>@prod.Stock</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No hay productos registrados o la API está apagada.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
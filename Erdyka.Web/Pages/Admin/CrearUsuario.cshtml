@page "{id:int?}"
@model Erdyka.Web.Pages.Admin.CrearUsuarioModel
@{
    bool esEdicion = Model.Input.UsuarioId > 0;
    ViewData["Title"] = esEdicion ? "Editar Usuario" : "Nuevo Usuario";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h2 class="mb-0">@(esEdicion ? "✏️ Editar Usuario" : "✨ Agregar Nuevo Usuario")</h2>
                </div>
                <div class="card-body">

                    <!-- Alerta por si la API rechaza el cambio -->
                    @if (!string.IsNullOrEmpty(Model.MensajeError))
                    {
                        <div class="alert alert-danger" role="alert">
                            @Model.MensajeError
                        </div>
                    }

                    <form method="post" class="mt-3">
                        <input type="hidden" asp-for="Input.UsuarioId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre de Usuario</label>
                            <input asp-for="Input.NombreUsuario" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Correo Electrónico</label>
                            <input asp-for="Input.Correo" type="email" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Contraseña</label>
                            <input asp-for="Input.Contrasena" type="password" class="form-control" placeholder="Escribe nueva contraseña o déjala así" />
                            <small class="text-muted">Si no deseas cambiarla, puedes escribir una temporal o dejarla en blanco.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Rol del Sistema</label>
                            <select asp-for="Input.RolId" class="form-select" required>
                                <option value="" disabled selected>Seleccione un rol...</option>
                                <option value="1">Administrador</option>
                                <option value="2">Usuario</option>
                            </select>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary px-4">
                                @(esEdicion ? "Actualizar Usuario" : "Guardar Usuario")
                            </button>
                            <a asp-page="./GestionUsuarios" class="btn btn-outline-secondary px-4">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>